# Что НЕ копируется в образ командой COPY . . (см. Dockerfile)

# Секреты: переменные передаются при запуске контейнера, а не хранятся в образе
.env

# Git и служебные файлы редактора
.git
.gitignore
.vscode
.idea

# Кэш Python - в контейнере он создаётся свой
__pycache__
*.pyc

# Сам Dockerfile и этот файл внутри образа не нужны
Dockerfile
.dockerignore
