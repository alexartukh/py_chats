# Образец файла .env. Скопируйте его в .env и заполните значения.
# Сам .env в git не попадает (он в .gitignore), этот образец - попадает.

# Подключение к PostgreSQL: postgres://<пользователь>:<пароль>@<хост>:<порт>/<база>
DATABASE_URL=

# Ключ подписи JWT-токенов. Любая длинная случайная строка, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Секретный ключ Django. Любая длинная случайная строка, сгенерировать так же, как JWT_SECRET
DJANGO_SECRET_KEY=

# Режим отладки: строго true или false
DJANGO_DEBUG=

# Адреса, по которым разрешено обращаться к серверу, через запятую, например: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=

# Откуда брать IP клиента: строго true или false.
#   false - сервер без прокси (локальный запуск): IP берётся из адреса соединения
#   true  - сервер за одним прокси (например, Render): IP берётся последним из заголовка X-Forwarded-For
CLIENT_IP_FROM_X_FORWARDED_FOR=
